FROM python:3.12-slim-bookworm AS source
ARG GROOT_REVISION=5dc80c4afd726b34faad1d8f7e007a13b34e4c88
WORKDIR /src
RUN python -c "from urllib.request import urlretrieve; urlretrieve('https://codeload.github.com/NVIDIA/Isaac-GR00T/tar.gz/${GROOT_REVISION}', '/tmp/groot.tar.gz')" \
    && tar xzf /tmp/groot.tar.gz --strip-components=1 "Isaac-GR00T-${GROOT_REVISION}/gr00t" "Isaac-GR00T-${GROOT_REVISION}/LICENSE"

FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
ENV PYTHONUNBUFFERED=1 HF_HUB_DISABLE_TELEMETRY=1 NO_ALBUMENTATIONS_UPDATE=1
WORKDIR /opt/isaac-gr00t
RUN pip install --no-cache-dir albumentations==1.4.18 opencv-python-headless==4.11.0.86 \
    av==16.1.0 diffusers==0.35.1 dm-tree==0.1.8 lmdb==1.7.5 \
    msgpack==1.1.0 msgpack-numpy==0.4.8 pandas==2.2.3 peft==0.17.1 \
    termcolor==3.2.0 transformers==4.51.3 tyro==0.9.17 \
    einops==0.8.1 numpy==1.26.4 scipy==1.15.3 omegaconf==2.3.0 \
    pyzmq==27.0.1 huggingface-hub==0.34.4 \
    && abi=$(python -c 'import torch; print(str(torch.compiled_with_cxx11_abi()).upper())') \
    && cp=$(python -c 'import sys; print(f"cp{sys.version_info.major}{sys.version_info.minor}")') \
    && pip install --no-cache-dir --no-deps \
    "https://github.com/Dao-AILab/flash-attention/releases/download/v2.7.4.post1/flash_attn-2.7.4.post1+cu12torch2.7cxx11abi${abi}-${cp}-${cp}-linux_x86_64.whl"
COPY --from=source /src/ ./
COPY policy_server.py ./
CMD ["python", "policy_server.py"]
